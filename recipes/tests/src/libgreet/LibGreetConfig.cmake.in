include(CMakeFindDependencyMacro)
find_dependency(LibHoller)

include("${CMAKE_CURRENT_LIST_DIR}/LibGreetTargets.cmake")
get_target_property(_LibGreetIncludeDirs LibGreet::LibGreet INTERFACE_INCLUDE_DIRECTORIES)
if(NOT _LibGreetIncludeDirs)
	set_property(TARGET LibGreet::LibGreet APPEND PROPERTY
		INTERFACE_INCLUDE_DIRECTORIES
			"@CMAKE_CURRENT_SOURCE_DIR@;@CMAKE_CURRENT_BINARY_DIR@"
	)
endif()
unset(_LibGreetIncludeDirs)
